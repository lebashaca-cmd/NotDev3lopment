<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bio | NotCr3st</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap');
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at center, #0a2a1a 0%, #020a06 100%);
            color: #e2e8f0;
            min-height: 100vh;
            overflow-x: hidden;
        }
        .star {
            position: absolute;
            background: white;
            border-radius: 50%;
            opacity: 0.5;
            animation: twinkle var(--duration) infinite ease-in-out;
        }
        @keyframes twinkle {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.2); }
        }
        .glow-text { text-shadow: 0 0 20px rgba(52, 211, 153, 0.6); }
        .glass {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .nav-pill {
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="relative">
    <div id="starfield" class="fixed inset-0 pointer-events-none"></div>
    <nav class="fixed top-6 left-1/2 -translate-x-1/2 z-50">
        <div class="nav-pill px-4 py-2 rounded-full flex items-center gap-6 text-gray-400">
            <a href="#home" class="hover:text-green-400 transition-colors"><i class="fa-solid fa-house"></i></a>
            <a href="#music" class="hover:text-green-400 transition-colors"><i class="fa-solid fa-music"></i></a>
            <a href="#about" class="hover:text-green-400 transition-colors"><i class="fa-solid fa-user"></i></a>
            <a href="#products" class="hover:text-green-400 transition-colors"><i class="fa-solid fa-desktop"></i></a>
            <a href="#products" class="hover:text-green-400 transition-colors"><i class="fa-solid fa-tag"></i></a>
            <div class="w-px h-4 bg-gray-700"></div>
            <a href="#" class="hover:text-green-400 transition-colors"><i class="fa-solid fa-envelope"></i></a>
        </div>
    </nav>

    <main id="home" class="relative z-10 max-w-3xl mx-auto px-6 pt-32 pb-20 text-center scroll-smooth">
        <section id="about" class="mb-32">
            <div class="relative inline-block mb-6">
                <img src="https://i.ibb.co/CKwjpVsN/image.png" alt="Avatar" class="w-32 h-32 rounded-full border-4 border-green-500/30 p-1">
                <div class="absolute bottom-2 right-2 w-6 h-6 bg-green-500 border-4 border-black rounded-full"></div>
            </div>
            <h1 class="text-6xl font-extrabold text-green-400 glow-text mb-6">NotCr3st</h1>
            <p class="text-lg text-gray-300 leading-relaxed mb-8 max-w-xl mx-auto">
                hi i'm <span class="text-white font-semibold">NotCr3st</span>, i'm <span class="text-white font-semibold">16 years old</span> and an upcoming developer. i love to build things such as
                <span class="text-green-400 underline decoration-green-500/50">discord bots</span>,
                <span class="text-green-400 underline decoration-green-500/50">websites</span>, and a lot more.
                i'm usually listening to music or helping clients on <span class="text-green-400 underline decoration-green-500/50">discord</span>.
            </p>
            <div class="flex justify-center gap-6 text-sm text-gray-400 mb-12">
                <a href="#" class="hover:text-white transition-colors flex items-center gap-2"><i class="fa-brands fa-github"></i> github</a>
                <a href="#" class="hover:text-white transition-colors flex items-center gap-2"><i class="fa-brands fa-discord"></i> discord</a>
            </div>
            <div class="glass p-4 rounded-2xl inline-flex items-center gap-4 text-left max-w-sm">
                <img src="https://i.ibb.co/CKwjpVsN/image.png" alt="Mini Avatar" class="w-10 h-10 rounded-full">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="font-semibold text-white">Killbyte - Proxy</span>
                        <span class="text-gray-500 text-xs">💬 🌐</span>
                    </div>
                    <a href="#" class="text-xs text-gray-400 hover:text-green-400 transition-colors">https://killbyte-tcuu.onrender.com/</a>
                </div>
            </div>
        </section>

        <section id="music" class="mb-32 text-left">
            <h2 class="text-3xl font-bold mb-2">Music</h2>
            <p class="text-gray-500 text-sm mb-6">currently listening to</p>
            <div id="spotify-status" class="glass p-6 rounded-2xl text-center text-gray-500 italic">Checking Spotify status...</div>
        </section>

        <section id="products" class="mb-32 text-left">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Products</p>
            <h2 class="text-4xl font-bold text-green-400 glow-text mb-8">What we've built</h2>
            <div class="space-y-6">
                <div class="group relative p-4 rounded-2xl transition-all hover:bg-white/5 cursor-pointer">
                    <div class="flex items-start gap-4">
                        <img src="https://via.placeholder.com/50" alt="Project" class="w-12 h-12 rounded-xl">
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <h3 class="text-xl font-semibold text-white group-hover:text-green-400 transition-colors">Killbyte (proxy) <i class="fa-solid fa-chevron-right text-xs opacity-50"></i></h3>
                                <div class="ml-auto flex gap-3 text-xs text-gray-500"><span>2k+ users</span><span>20+ servers</span></div>
                            </div>
                            <p class="text-gray-400 text-sm mt-1">A brief description of your awesome project goes here.</p>
                        </div>
                    </div>
                    <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-0 bg-green-500 transition-all group-hover:h-full rounded-r-full"></div>
                </div>
                <div class="group relative p-4 rounded-2xl transition-all hover:bg-white/5 cursor-pointer">
                    <div class="flex items-start gap-4">
                        <img src="https://via.placeholder.com/50" alt="Project" class="w-12 h-12 rounded-xl">
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <h3 class="text-xl font-semibold text-white group-hover:text-green-400 transition-colors">Another Project <i class="fa-solid fa-chevron-right text-xs opacity-50"></i></h3>
                                <div class="ml-auto flex gap-3 text-xs text-gray-500"><span>500+ users</span></div>
                            </div>
                            <p class="text-gray-400 text-sm mt-1">A second project description that highlights different features.</p>
                        </div>
                    </div>
                    <div class="absolute left-0 top-1/2 -translate-y-1/2 w-1 h-0 bg-green-500 transition-all group-hover:h-full rounded-r-full"></div>
                </div>
            </div>
        </section>

        <section class="text-center">
            <h2 class="text-3xl font-bold mb-2">Friends</h2>
            <p class="text-gray-500 text-sm mb-10">meet my friends you might like them too.</p>
            <div class="flex justify-center gap-8" id="friends-list"></div>
        </section>
    </main>

    <script>
        const starfield = document.getElementById('starfield');
        const starCount = 150;
        for (let i = 0; i < starCount; i++) {
            const star = document.createElement('div');
            star.className = 'star';
            const size = Math.random() * 2 + 1;
            star.style.width = `${size}px`;
            star.style.height = `${size}px`;
            star.style.left = `${Math.random() * 100}%`;
            star.style.top = `${Math.random() * 100}%`;
            const duration = Math.random() * 3 + 2;
            star.style.setProperty('--duration', `${duration}s`);
            star.style.animationDelay = `${Math.random() * 5}s`;
            starfield.appendChild(star);
        }

        async function updateSpotify() {
            const userId = '792225954524823573';
            const statusDiv = document.getElementById('spotify-status');
            if (!statusDiv) return;
            try {
                const response = await fetch(`https://api.lanyard.ninja/v1/users/${userId}`);
                const data = await response.json();
                if (data.success && data.data.spotify) {
                    const track = data.data.spotify;
                    statusDiv.innerHTML = `
                        <div class="flex items-center gap-4 text-left italic-none">
                            <img src="${track.album.image_url}" class="w-16 h-16 rounded-lg shadow-lg">
                            <div class="text-left">
                                <div class="text-white font-semibold text-lg">${track.track}</div>
                                <div class="text-green-400 text-sm">${track.artist}</div>
                            </div>
                        </div>
                    `;
                    statusDiv.classList.remove('text-center', 'text-gray-500', 'italic');
                } else {
                    statusDiv.innerText = 'Not listening to anything on Spotify right now';
                }
            } catch (e) { statusDiv.innerText = 'Could not load Spotify status'; }
        }

        async function updateFriends() {
            const friends = [
                { id: '1447292903654428733', name: 'Terrified' },
                { id: '689557846991306802', name: 'Luna' },
                { id: 'ID_3', name: 'Friend 3' },
                { id: 'ID_4', name: 'Friend 4' },
            ];
            const friendsList = document.getElementById('friends-list');
            if (!friendsList) return;
            try {
                const friendsHtml = await Promise.all(friends.map(async (friend) => {
                    try {
                        const response = await fetch(`https://api.lanyard.ninja/v1/users/${friend.id}`);
                        const data = await response.json();
                        let statusColor = 'bg-gray-500';
                        let avatarUrl = 'https://via.placeholder.com/60';
                        if (data.success && data.data) {
                            const status = data.data.discord_status;
                            if (status === 'online') statusColor = 'bg-green-500';
                            else if (status === 'idle') statusColor = 'bg-yellow-500';
                            else if (status === 'dnd') statusColor = 'bg-red-500';
                            else statusColor = 'bg-gray-500';
                            const hash = data.data.discord_avatar;
                            if (hash) {
                                avatarUrl = `https://cdn.discordapp.com/avatars/${friend.id}/${hash}.png`;
                            } else {
                                avatarUrl = `https://cdn.discordapp.com/embeds/${friend.id}/default.png`;
                            }
                        }
                        return `
                            <a href="#" class="group relative">
                                <div class="relative">
                                    <img src="${avatarUrl}" alt="${friend.name}" class="w-16 h-16 rounded-full grayscale group-hover:grayscale-0 transition-all border-2 border-transparent group-hover:border-green-500" onerror="this.src='https://via.placeholder.com/60'">
                                    <div class="absolute bottom-1 right-1 w-4 h-4 rounded-full border-2 border-black ${statusColor}" title="${friend.name}"></div>
                                </div>
                            </a>
                        `;
                    } catch (e) {
                        return `
                            <a href="#" class="group relative">
                                <div class="relative">
                                    <img src="https://via.placeholder.com/60" alt="${friend.name}" class="w-16 h-16 rounded-full grayscale group-hover:grayscale-0 transition-all border-2 border-transparent group-hover:border-green-500">
                                    <div class="absolute bottom-1 right-1 w-4 h-4 rounded-full border-2 border-black bg-gray-500" title="${friend.name}"></div>
                                </div>
                            </a>
                        `;
                    }
                }));
                friendsList.innerHTML = friendsHtml.join('');
            } catch (e) { console.error(e); }
        }

        updateSpotify();
        updateFriends();
        setInterval(() => { updateSpotify(); updateFriends(); }, 30000);
    </script>
</body>
</html>
